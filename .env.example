# CONFIGURAÇÕES DE AMBIENTE DA CENTRAL DE ATENDIMENTO — CLÍNICA SANDIEGO

# Ambiente Operacional (development | staging | production)
VITE_ENV=development

# Servidor Backend & API Central
VITE_API_URL=http://localhost:4000/api

# Integração WhatsApp (Provedores Suportados: meta_cloud_api | evolution_api)
VITE_WHATSAPP_PROVIDER=meta_cloud_api
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_TOKEN=
VITE_WHATSAPP_WEBHOOK_URL=https://api.clinicasandiego.com.br/v1/webhooks/whatsapp
VITE_WHATSAPP_WEBHOOK_SECRET=

# Integração com o Sistema de Agendamentos Próprio da Clínica Sandiego
VITE_CLINIC_API_ENABLED=false
VITE_CLINIC_API_URL=
VITE_CLINIC_API_TOKEN=
VITE_CLINIC_WEBHOOK_SECRET=
